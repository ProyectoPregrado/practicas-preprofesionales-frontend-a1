{
  "name": "template-practicas-preprofesionales-frontend-v1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cliente offline-first para gestión de prácticas preprofesionales.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "lint:report": "eslint . -f json -o eslint-report.json",
    "typecheck": "tsc --noEmit",
    "dup": "jscpd src --reporters json --output .jscpd"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
